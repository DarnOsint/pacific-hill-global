# =============================================================================
# Pacific Hill Global — environment configuration
#
# Copy to `.env.local` for development. NEVER commit a populated .env file.
#
#   cp .env.example .env.local
#
# Build the app once before this file exists: the platform degrades to a
# read-only, unconfigured state rather than crashing, so `next build` and CI
# work without secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public site origin. No trailing slash. Used for canonical URLs, sitemap,
# Open Graph, and cookie security decisions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Short company name used in titles and structured data.
NEXT_PUBLIC_COMPANY_NAME=Pacific Hill Global

# -----------------------------------------------------------------------------
# Supabase — required for auth, database and storage
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The *publishable* / anon key. Safe to expose to the browser: every table is
# protected by Row Level Security, so this key grants no access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The *secret* / service_role key. SERVER ONLY. Used for the few operations that
# cannot be performed as the signed-in user (bootstrap admin, password reset
# administration, webhook verification). Never import it into a client
# component, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Authentication policy
# -----------------------------------------------------------------------------
# Absolute session lifetime in seconds. After this a session is refused even if
# the underlying token has not expired. Default: 12 hours.
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# Idle timeout in seconds. Default: 2 hours.
SESSION_IDLE_TIMEOUT_SECONDS=7200

# Set true to require every login to complete an MFA challenge.
# Requires the MFA enrolment flow to be configured for each employee.
NEXT_PUBLIC_REQUIRE_MFA=false

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Maximum upload size in bytes. Default 25 MiB.
MAX_UPLOAD_BYTES=26214400

# Bucket names. Create them in Supabase Storage, all PRIVATE except
# `website-public` which serves the public site through the image transformer.
STORAGE_BUCKET_WEBSITE_PUBLIC=website-public
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_EMPLOYEES=employees
STORAGE_BUCKET_MESSAGES=messages
STORAGE_BUCKET_FINANCE=finance

# -----------------------------------------------------------------------------
# Rate limiting (per-instance; move to Upstash for multi-region enforcement)
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_WRITE_ACTIONS_PER_MINUTE=120

# -----------------------------------------------------------------------------
# Scheduled jobs
# -----------------------------------------------------------------------------
# Bearer token required by GET /api/cron/expire
CRON_SECRET=

# -----------------------------------------------------------------------------
# Company email integration (Phase 5)
# -----------------------------------------------------------------------------
# Provider is selected by EMAIL_PROVIDER. Architecture: lib/email/providers.
# Leave EMAIL_PROVIDER empty to run with the platform's internal mailbox only.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=no-reply@pacifichillglobal.com
EMAIL_FROM_NAME=Pacific Hill Global

# Google Workspace (OAuth2 service account or domain-wide delegation)
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_ADMIN_EMAIL=

# Microsoft 365
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

# Zoho Mail
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Error reporting. Leave empty to log to the server console only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
